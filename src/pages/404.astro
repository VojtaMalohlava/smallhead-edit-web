---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Stránka nenalezena" description="Tahle stránka neexistuje nebo byla přesunuta.">
  <div class="section-shell section--green">
    <div class="wrap page-section not-found">
      <span class="not-found__code" aria-hidden="true">404</span>
      <h1>Tahle stránka tu není.</h1>
      <p>
        Odkaz je asi špatně nebo se stránka mezitím přesunula. Zkuste to
        znovu z úvodní stránky.
      </p>
      <a class="btn" href="/">Zpátky na úvod</a>
    </div>
  </div>
</Layout>
