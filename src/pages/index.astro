---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import SectionMarker from "../components/SectionMarker.astro";
import { featuredProjects, horizontalProjects } from "../data/projects";
import { references } from "../data/references";
import portrait from "../assets/vojta-portret.jpg";

// Video na pozadí hera: projekt označený `heroBackground: true` v
// projects.js, jinak první horizontální projekt v poli.
const heroProject = horizontalProjects.find((p) => p.heroBackground) ?? horizontalProjects[0];
const heroPosterUrl = `https://img.youtube.com/vi/${heroProject.youtubeId}/maxresdefault.jpg`;

const pickerFields = ({ title, client, category, format, youtubeId, description }: (typeof featuredProjects)[number]) => ({
  title,
  client,
  category,
  format,
  youtubeId,
  description,
});

const pickerData = {
  horizontal: featuredProjects.filter((p) => p.format === "horizontal").map(pickerFields),
  vertical: featuredProjects.filter((p) => p.format === "vertical").map(pickerFields),
};
---

<Layout title="Úvod">
  <div class="section-shell section--green">
    <div class="hero-media" aria-hidden="true">
      <div class="hero-media__poster" style={`background-image: url(${heroPosterUrl});`}></div>
      <div class="hero-media__frame" id="hero-video-frame" data-youtube-id={heroProject.youtubeId}></div>
      <div class="hero-media__overlay"></div>
    </div>

    <div class="wrap hero">
      <SectionMarker time="00:00" label="Úvod" />
      <div class="hero-text">
        <h1>Materiál máte natočený. My zařídíme, aby výsledek fungoval.</h1>
      </div>
      <p>
        Kompletní postprodukce videa — střih, barevné korekce, motion design i
        zvuk — v DaVinci Resolve a Fusion. Pracujeme s filmovým tempem a
        rytmem, protože víme, jakými prostředky udržet pozornost diváka.
        Podívejte se, jak to vypadá na reálných projektech.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/#kontakt">Poslat zadání</a>
        <a class="btn btn--secondary" href="/portfolio">Prohlédnout projekty</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const frame = document.getElementById("hero-video-frame");
      if (!frame) return;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Při omezeném pohybu se iframe vůbec nevkládá — zůstane jen
      // statický náhled s překryvem (viz .hero-media__poster).
      if (prefersReducedMotion) return;

      const youtubeId = frame.dataset.youtubeId;
      if (!youtubeId) return;

      const iframe = document.createElement("iframe");
      iframe.src =
        `https://www.youtube.com/embed/${youtubeId}` +
        `?autoplay=1&mute=1&loop=1&playlist=${youtubeId}` +
        `&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3`;
      iframe.title = "";
      iframe.setAttribute("aria-hidden", "true");
      iframe.setAttribute("tabindex", "-1");
      iframe.setAttribute("allow", "autoplay; encrypted-media");
      frame.appendChild(iframe);
    })();
  </script>

  <Timeline>
  <div class="section-shell section--cream" id="ukazky">
    <section class="wrap page-section">
      <div class="section-head">
        <div>
          <SectionMarker time="00:01" label="Ukázky práce" />
          <div class="section-heading">
            <h2>Ukázky práce</h2>
          </div>
        </div>
        <a class="more" href="/portfolio">Zobrazit celé portfólio</a>
      </div>

      <div
        class="video-group bleed-up"
        id="ukazky-lead"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      ></div>

      <div class="video-group showcase-trio" id="ukazky-vertical"></div>
    </section>
  </div>

  <script type="application/json" id="ukazky-data" is:inline set:html={JSON.stringify(pickerData)} />
  <script is:inline>
    function pickRandom(list, count) {
      const pool = [...list];
      const picked = [];
      while (picked.length < count && pool.length > 0) {
        const index = Math.floor(Math.random() * pool.length);
        picked.push(pool.splice(index, 1)[0]);
      }
      return picked;
    }

    function thumbUrl(project) {
      const quality = project.format === "horizontal" ? "maxresdefault" : "hqdefault";
      return `https://img.youtube.com/vi/${project.youtubeId}/${quality}.jpg`;
    }

    function cardHtml(project) {
      const clientMarkup = project.client ? `<p class="client">${project.client}</p>` : "";
      return `
        <article class="video-card" data-format="${project.format}">
          <button
            class="video-card__thumb"
            type="button"
            data-yt-id="${project.youtubeId}"
            data-yt-title="${project.title}"
            aria-label="Přehrát ukázku: ${project.title}"
          >
            <img src="${thumbUrl(project)}" alt="" loading="lazy" />
            <span class="video-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </button>
          <div class="video-card__meta">
            <span class="tag">${project.category}</span>
            <h3>${project.title}</h3>
            ${clientMarkup}
            <p class="desc">${project.description}</p>
          </div>
        </article>
      `;
    }

    const dataEl = document.getElementById("ukazky-data");
    const data = dataEl ? JSON.parse(dataEl.textContent || "{}") : { horizontal: [], vertical: [] };

    const leadContainer = document.getElementById("ukazky-lead");
    const verticalContainer = document.getElementById("ukazky-vertical");

    if (leadContainer) {
      leadContainer.innerHTML = pickRandom(data.horizontal || [], 1).map(cardHtml).join("");
    }
    if (verticalContainer) {
      verticalContainer.innerHTML = pickRandom(data.vertical || [], 3).map(cardHtml).join("");
    }
  </script>

  <div class="section-shell section--green-alt" id="klienti">
    <section class="wrap clients-strip">
      <p class="clients-intro">Pracoval jsem pro</p>
      <ul class="client-list">
        <li>North Moravians</li>
        <li>TMRW Film</li>
        <li>Vesalius</li>
        <li>Dotykačka</li>
        <li>Placement</li>
        <li>Perfectology Brno</li>
        <li>Choice</li>
      </ul>
    </section>
  </div>

  <div class="section-shell section--green" id="o-mne">
    <section class="wrap page-section text-section about">
      <div
        class="about-portrait bleed-up"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      >
        <Image src={portrait} alt="Vojtěch Malohlava" width={640} height={800} />
      </div>
      <div class="about-content">
        <SectionMarker time="00:02" label="O mně" />
        <div class="section-heading">
          <h2>O mně</h2>
        </div>
        <p>Nezačal jsem střihem. Začal jsem tím, že jsem chtěl něco ukázat.</p>
        <p>
          Vlogy z vesnice. Potom sestřihy z fotbalu. Roky předtím, než mě
          napadlo, že by z toho mohla být práce.
        </p>
        <p>
          Někde po cestě mi došlo, že mě nebaví natáčení. Baví mě to, co přijde
          potom — moment, kdy se z hodin materiálu skládá něco, co má tempo a
          drží pohromadě. Postprodukce není poslední krok výroby videa. Je to
          krok, ve kterém video buď začne fungovat, nebo ne.
        </p>
        <a class="more" href="/o-mne">Celý příběh</a>
      </div>
    </section>
  </div>

  <div class="section-shell section--green-alt" id="reference">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:03" label="Reference" />
      <div class="section-heading">
        <h2>Co o nás říkají zákazníci</h2>
      </div>
      <div class="references-grid">
        {references.map((item) => (
          <article class="reference-card">
            <div class="reference-illustration" aria-hidden="true">
              <svg viewBox="0 0 64 64" role="img" aria-hidden="true">
                <g fill="currentColor">
                  <circle cx="32" cy="23" r="10" />
                  <path d="M14 54c0-12.7 8.1-20 18-20s18 7.3 18 20z" />
                </g>
              </svg>
            </div>
            <blockquote>
              <p>„{item.quote}“</p>
            </blockquote>
            <footer>
              <span class="reference-type">{item.type}</span>
              <span class="reference-name">{item.name}</span>
            </footer>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="section-shell section--green" id="sluzby">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:04" label="Služby" />
      <div class="section-heading">
        <h2>Služby</h2>
      </div>

      <div class="services-grid">
        <article class="service">
          <h3>1 — Edit</h3>
          <p class="lead">
            Kompletní postprodukce. Od surového materiálu po soubor, který jde
            rovnou publikovat.
          </p>
          <p>
            Střih, barevné korekce v DaVinci Resolve, zvuk a mix, motion
            design i titulky — všechno v jedné službě.
          </p>
          <a class="more" href="/sluzby#edit">Podrobnosti a ceník</a>
        </article>

        <article class="service">
          <h3>2 — Konzultace</h3>
          <p class="lead">
            Máte hotové video, které nefunguje. Nebo ho zrovna stříháte a
            nejste si jistí.
          </p>
          <p>
            Projdu vaše video a řeknu vám, co ho brzdí a kde diváci odcházejí
            a proč.
          </p>
          <a class="more" href="/sluzby#konzultace">Podrobnosti a ceník</a>
        </article>
      </div>
    </section>
  </div>

  <div class="section-shell section--green-alt" id="kontakt">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:05" label="Kontakt" />
      <div class="section-heading">
        <h2>Máte materiál a termín?</h2>
      </div>
      <p>
        Napište mi, o co jde a dokdy to potřebujete. Ozvu se do druhého dne s
        tím, jestli to stihnu a co to bude stát.
      </p>
      <a class="btn" href="mailto:vojta.malohlava1@gmail.com">Napsat e-mail</a>
    </section>
  </div>
  </Timeline>
</Layout>
