---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import SectionMarker from "../components/SectionMarker.astro";
import ReferenceIllustration from "../components/ReferenceIllustration.astro";
import ContactForm from "../components/ContactForm.astro";
import VideoCard from "../components/VideoCard.astro";
import { featuredProjects, horizontalProjects } from "../data/projects";
import { references } from "../data/references";
import portrait from "../assets/vojta-portret.jpg";

// Video na pozadí hera: náhodně vybrané z horizontálních projektů,
// pokaždé jiné při načtení stránky (viz skript pod hero sekcí). Tohle
// je jen fallback pro poster, než/pokud se JS nespustí.
const heroProject = horizontalProjects.find((p) => p.heroBackground) ?? horizontalProjects[0];
const heroPosterUrl = `https://img.youtube.com/vi/${heroProject.youtubeId}/maxresdefault.jpg`;
const heroPickerData = horizontalProjects.map((p) => p.youtubeId);

// Kandidáti pro "Ukázky práce": VŠECHNY featured projekty daného formátu
// se vykreslí rovnou do HTML (ať je vyhledávače vidí), CSS ve výchozím
// stavu zobrazí jen první 3 (1 horizontální + 2 vertikální) a inline
// skript pod mřížkou (viz níže) mezi nimi náhodně přepne, které se
// reálně ukážou.
const ukazkyHorizontal = featuredProjects.filter((p) => p.format === "horizontal");
const ukazkyVertical = featuredProjects.filter((p) => p.format === "vertical");
---

<Layout
  title="Úvod"
  description="Kompletní postprodukce videa — střih, barevné korekce, motion design i zvuk. Na dálku pro klienty v Česku i na Slovensku. Podívejte se na ukázky práce."
>
  <div class="section-shell section--green hero-shell">
    <div class="hero-media" aria-hidden="true">
      <div class="hero-media__poster" style={`background-image: url(${heroPosterUrl});`}></div>
      <div class="hero-media__frame" id="hero-video-frame" data-youtube-id={heroProject.youtubeId}></div>
      <div class="hero-media__overlay"></div>
    </div>

    <script type="application/json" id="hero-video-data" is:inline set:html={JSON.stringify(heroPickerData)} />

    <div class="wrap hero">
      <SectionMarker time="00:00" label="Úvod" />
      <div class="hero-text">
        <h1>Materiál máte natočený. My zařídíme, aby výsledek fungoval.</h1>
      </div>
      <p>
        Kompletní postprodukce videa — střih, barevné korekce, motion design i
        zvuk — v DaVinci Resolve a Fusion. Pracujeme s filmovým tempem a
        rytmem, protože víme, jakými prostředky udržet pozornost diváka.
        Podívejte se, jak to vypadá na reálných projektech.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/#kontakt">Poslat zadání</a>
        <a class="btn btn--secondary" href="/portfolio">Prohlédnout projekty</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const frame = document.getElementById("hero-video-frame");
      if (!frame) return;

      // Náhodný výběr videa na pozadí hera při každém načtení stránky —
      // z celého seznamu horizontálních projektů, ne vždycky to stejné.
      const dataEl = document.getElementById("hero-video-data");
      let youtubeId = frame.dataset.youtubeId;
      if (dataEl) {
        try {
          const ids = JSON.parse(dataEl.textContent || "[]");
          if (Array.isArray(ids) && ids.length) {
            youtubeId = ids[Math.floor(Math.random() * ids.length)];
          }
        } catch (e) {}
      }
      if (!youtubeId) return;

      // Poster se aktualizuje vždy, i při omezeném pohybu — je to jediné,
      // co uživatel s prefers-reduced-motion nakonec uvidí.
      const poster = document.querySelector(".hero-media__poster");
      if (poster) {
        poster.style.backgroundImage = `url(https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg)`;
      }

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Při omezeném pohybu se iframe vůbec nevkládá — zůstane jen
      // statický náhled s překryvem (viz .hero-media__poster).
      if (prefersReducedMotion) return;

      const iframe = document.createElement("iframe");
      iframe.src =
        `https://www.youtube.com/embed/${youtubeId}` +
        `?autoplay=1&mute=1&loop=1&playlist=${youtubeId}` +
        `&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3`;
      iframe.title = "";
      iframe.setAttribute("aria-hidden", "true");
      iframe.setAttribute("tabindex", "-1");
      iframe.setAttribute("allow", "autoplay; encrypted-media");
      frame.appendChild(iframe);
    })();
  </script>

  <Timeline>
  <div class="section-shell section--cream" id="ukazky">
    <section class="wrap page-section">
      <SectionMarker time="00:01" label="Ukázky práce" />
      <div class="section-heading">
        <h2>Ukázky práce</h2>
      </div>

      <div
        class="video-group bleed-up"
        id="ukazky-lead"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      >
        {ukazkyHorizontal.map((project) => <VideoCard project={project} />)}
      </div>

      <div class="video-group showcase-pair" id="ukazky-vertical">
        {ukazkyVertical.map((project) => <VideoCard project={project} />)}
      </div>

      <div class="section-cta">
        <a class="btn btn--secondary" href="/portfolio">Prohlédnout celé portfolio</a>
      </div>
    </section>
  </div>

  <script is:inline>
    // Všechny kandidátské karty jsou už v HTML (viz VideoCard výše), CSS
    // ve výchozím stavu ukazuje jen první 3 (1 horizontální + 2
    // vertikální). Tenhle skript běží synchronně hned za mřížkou, ještě
    // před prvním vykreslením — přepne viditelnost na náhodný výběr, aniž
    // by došlo k probliknutí nebo posunu rozvržení.
    (function () {
      function pickIndices(total, count) {
        const pool = [];
        for (let i = 0; i < total; i++) pool.push(i);
        const picked = [];
        while (picked.length < count && pool.length > 0) {
          const index = Math.floor(Math.random() * pool.length);
          picked.push(pool.splice(index, 1)[0]);
        }
        return picked;
      }

      function showOnly(cards, indices) {
        // Explicitní "block"/"none" přes inline styl, ne prázdný řetězec
        // — kdyby se jen odstranil inline styl, spadlo by to zpátky na
        // CSS výchozí pravidlo (které ukazuje vždy jen první kartu) a
        // u jiného než prvního indexu by se karta nezobrazila vůbec.
        cards.forEach((card, i) => {
          card.style.display = indices.includes(i) ? "block" : "none";
        });
      }

      const leadCards = document.querySelectorAll("#ukazky-lead .video-card");
      const vertCards = document.querySelectorAll("#ukazky-vertical .video-card");

      if (leadCards.length) showOnly(leadCards, pickIndices(leadCards.length, 1));
      if (vertCards.length) showOnly(vertCards, pickIndices(vertCards.length, Math.min(2, vertCards.length)));
    })();
  </script>

  <div class="section-shell section--green-alt" id="klienti">
    <section class="wrap clients-strip">
      <p class="clients-intro">Pracoval jsem pro</p>
      <ul class="client-list">
        <li>North Moravians</li>
        <li>TMRW Film</li>
        <li>Vesalius</li>
        <li>Dotykačka</li>
        <li>Placement</li>
        <li>Perfectology Brno</li>
        <li>Choice</li>
      </ul>
    </section>
  </div>

  <div class="section-shell section--green" id="sluzby">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:02" label="Služby" />
      <div class="section-heading">
        <h2>Služby</h2>
      </div>

      <div class="services-grid">
        <article class="service">
          <span class="service-number" aria-hidden="true">1</span>
          <h3>Edit</h3>
          <p class="lead">
            Kompletní postprodukce. Od surového materiálu po soubor, který jde
            rovnou publikovat.
          </p>
          <p>
            Střih, barevné korekce v DaVinci Resolve, zvuk a mix, motion
            design i titulky — všechno v jedné službě.
          </p>
          <a class="more" href="/sluzby#edit">Podrobnosti a ceník</a>
        </article>

        <article class="service">
          <span class="service-number" aria-hidden="true">2</span>
          <h3>Konzultace</h3>
          <p class="lead">
            Máte hotové video, které nefunguje. Nebo ho zrovna stříháte a
            nejste si jistí.
          </p>
          <p>
            Projdu vaše video a řeknu vám, co ho brzdí a kde diváci odcházejí
            a proč.
          </p>
          <a class="more" href="/sluzby#konzultace">Podrobnosti a ceník</a>
        </article>
      </div>
    </section>
  </div>

  <div class="section-shell section--green-alt" id="reference">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:03" label="Reference" />
      <div class="section-heading">
        <h2>Co o nás říkají zákazníci</h2>
      </div>
      <div class="references-grid">
        {references.map((item) => (
          <article class="reference-card">
            <div class="reference-illustration">
              <ReferenceIllustration type={item.type} />
            </div>
            <blockquote>
              <p>„{item.quote}“</p>
            </blockquote>
            <footer>
              <span class="reference-type">{item.type}</span>
              <span class="reference-name">{item.name}</span>
            </footer>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="section-shell section--green" id="kontakt">
    <section class="wrap page-section text-section">
      <SectionMarker time="00:04" label="Kontakt" />
      <div class="section-heading">
        <h2>Máte materiál a termín?</h2>
      </div>
      <p>
        Napište mi, o co jde a dokdy to potřebujete. Ozvu se do druhého dne s
        tím, jestli to stihnu a co to bude stát.
      </p>
      <ContactForm />
    </section>
  </div>

  <div class="section-shell section--green-alt" id="o-mne">
    <section class="wrap page-section text-section about">
      <div
        class="about-portrait bleed-up"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      >
        <Image src={portrait} alt="Vojtěch Malohlava" width={640} height={800} />
      </div>
      <div class="about-content">
        <SectionMarker time="00:05" label="O mně" />
        <div class="section-heading">
          <h2>O mně</h2>
        </div>
        <p>Nezačal jsem střihem. Začal jsem tím, že jsem chtěl něco ukázat.</p>
        <p>
          Vlogy z vesnice. Potom sestřihy z fotbalu. Roky předtím, než mě
          napadlo, že by z toho mohla být práce.
        </p>
        <p>
          Někde po cestě mi došlo, že mě nebaví natáčení. Baví mě to, co přijde
          potom — moment, kdy se z hodin materiálu skládá něco, co má tempo a
          drží pohromadě. Postprodukce není poslední krok výroby videa. Je to
          krok, ve kterém video buď začne fungovat, nebo ne.
        </p>
        <a class="more" href="/o-mne">Celý příběh</a>
      </div>
    </section>
  </div>
  </Timeline>
</Layout>
