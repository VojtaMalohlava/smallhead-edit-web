---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { featuredProjects, horizontalProjects } from "../data/projects";
import portrait from "../assets/vojta-portret.jpg";
import referenceRaw from "../data/reference.txt?raw";

// Video na pozadí hera: projekt označený `heroBackground: true` v
// projects.js, jinak první horizontální projekt v poli.
const heroProject = horizontalProjects.find((p) => p.heroBackground) ?? horizontalProjects[0];
const heroPosterUrl = `https://img.youtube.com/vi/${heroProject.youtubeId}/maxresdefault.jpg`;

type Testimonial = { name: string; role: string; quote: string };

// Soubor src/data/reference.txt: každá nová recenze začíná řádkem "Jméno:"
// (nezáleží na prázdných řádcích mezi recenzemi ani uvnitř textu recenze),
// následuje řádek "Typ:" a pak samotný text. Řádky s # se přeskakují.
function parseTestimonials(raw: string): Testimonial[] {
  const entries: string[][] = [];
  let current: string[] | null = null;

  for (const rawLine of raw.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith("#")) continue;
    if (/^jm[ée]no:/i.test(line)) {
      current = [line];
      entries.push(current);
    } else if (current) {
      current.push(line);
    }
  }

  return entries
    .map((lines) => {
      const nameLine = lines[0];
      const roleLine = lines.find((line) => /^typ:/i.test(line));
      if (!roleLine) return null;
      const quote = lines
        .slice(1)
        .filter((line) => line !== roleLine)
        .join(" ")
        .trim();
      if (!quote) return null;
      return {
        name: nameLine.replace(/^jm[ée]no:/i, "").trim(),
        role: roleLine.replace(/^typ:/i, "").trim(),
        quote,
      };
    })
    .filter((item): item is Testimonial => item !== null);
}

function stripDiacritics(value: string) {
  return value
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase();
}

// Minimalistické ikonky na pozadí avataru podle profese z pole "Typ:".
// Neznámá profese dostane neutrální výchozí ikonu (jiskřičku).
const AVATAR_ICONS: { match: RegExp; icon: string }[] = [
  {
    match: /market/,
    icon: `<rect x="16" y="38" width="6" height="12" rx="1"/><rect x="26" y="30" width="6" height="20" rx="1"/><rect x="36" y="22" width="6" height="28" rx="1"/>`,
  },
  {
    match: /realit|makler/,
    icon: `<path d="M14 30 L32 16 L50 30" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="20" y="30" width="24" height="18" fill="none" stroke="currentColor" stroke-width="2.5"/>`,
  },
  {
    match: /fitness|trener|kouc/,
    icon: `<g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"><path d="M14 32h6M44 32h6M20 32h24"/><rect x="10" y="27" width="6" height="10" rx="1"/><rect x="48" y="27" width="6" height="10" rx="1"/></g>`,
  },
  {
    match: /program|vyvoj|it |developer|tech/,
    icon: `<g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M24 24 L16 32 L24 40"/><path d="M40 24 L48 32 L40 40"/></g>`,
  },
  {
    match: /e-?shop|obchod|prodej/,
    icon: `<g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 24h28l-3 20H21z"/><path d="M24 24v-4a8 8 0 0 1 16 0v4"/></g>`,
  },
  {
    match: /foto/,
    icon: `<g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="24" width="36" height="24" rx="3"/><circle cx="32" cy="36" r="7"/><path d="M24 24l3-5h10l3 5"/></g>`,
  },
  {
    match: /film|video|produkc/,
    icon: `<g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="22" width="40" height="26" rx="2"/><path d="M12 30h40M18 22l4 8M28 22l4 8M38 22l4 8"/></g>`,
  },
];

const DEFAULT_ICON = `<g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M32 16v8M32 40v8M16 32h8M40 32h8M21 21l6 6M37 37l6 6M43 21l-6 6M27 37l-6 6"/></g>`;

function avatarSvg(role: string) {
  const normalized = stripDiacritics(role);
  const match = AVATAR_ICONS.find((entry) => entry.match.test(normalized));
  const icon = match ? match.icon : DEFAULT_ICON;
  return `<svg viewBox="0 0 64 64" role="img" aria-hidden="true">
    <g opacity="0.45">${icon}</g>
    <g fill="currentColor">
      <circle cx="32" cy="23" r="10"/>
      <path d="M14 54c0-12.7 8.1-20 18-20s18 7.3 18 20z"/>
    </g>
  </svg>`;
}

const testimonials = parseTestimonials(referenceRaw);

const pickerFields = ({ title, client, category, format, youtubeId, description }: (typeof featuredProjects)[number]) => ({
  title,
  client,
  category,
  format,
  youtubeId,
  description,
});

const pickerData = {
  horizontal: featuredProjects.filter((p) => p.format === "horizontal").map(pickerFields),
  vertical: featuredProjects.filter((p) => p.format === "vertical").map(pickerFields),
};
---

<Layout title="Úvod">
  <div class="section-shell section--green">
    <div class="hero-media" aria-hidden="true">
      <div class="hero-media__poster" style={`background-image: url(${heroPosterUrl});`}></div>
      <div class="hero-media__frame" id="hero-video-frame" data-youtube-id={heroProject.youtubeId}></div>
      <div class="hero-media__overlay"></div>
    </div>

    <div class="wrap hero">
      <div class="hero-text">
        <h1>Materiál máte natočený. My zařídíme, aby výsledek fungoval.</h1>
      </div>
      <p>
        Kompletní postprodukce videa — střih, barevné korekce, motion design i
        zvuk — v DaVinci Resolve a Fusion. Pracujeme s filmovým tempem a
        rytmem, protože víme, jakými prostředky udržet pozornost diváka.
        Podívejte se, jak to vypadá na reálných projektech.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/#kontakt">Poslat zadání</a>
        <a class="btn btn--secondary" href="/portfolio">Prohlédnout projekty</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const frame = document.getElementById("hero-video-frame");
      if (!frame) return;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Při omezeném pohybu se iframe vůbec nevkládá — zůstane jen
      // statický náhled s překryvem (viz .hero-media__poster).
      if (prefersReducedMotion) return;

      const youtubeId = frame.dataset.youtubeId;
      if (!youtubeId) return;

      const iframe = document.createElement("iframe");
      iframe.src =
        `https://www.youtube.com/embed/${youtubeId}` +
        `?autoplay=1&mute=1&loop=1&playlist=${youtubeId}` +
        `&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3`;
      iframe.title = "";
      iframe.setAttribute("aria-hidden", "true");
      iframe.setAttribute("tabindex", "-1");
      iframe.setAttribute("allow", "autoplay; encrypted-media");
      frame.appendChild(iframe);
    })();
  </script>

  <div class="section-shell section--cream" id="ukazky">
    <section class="wrap page-section">
      <div class="section-head">
        <div class="section-heading">
          <h2>Ukázky práce</h2>
        </div>
        <a class="more" href="/portfolio">Zobrazit celé portfólio</a>
      </div>

      <div
        class="video-group bleed-up"
        id="ukazky-lead"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      ></div>

      <div class="video-group showcase-trio" id="ukazky-vertical"></div>
    </section>
  </div>

  <script type="application/json" id="ukazky-data" is:inline set:html={JSON.stringify(pickerData)} />
  <script is:inline>
    function pickRandom(list, count) {
      const pool = [...list];
      const picked = [];
      while (picked.length < count && pool.length > 0) {
        const index = Math.floor(Math.random() * pool.length);
        picked.push(pool.splice(index, 1)[0]);
      }
      return picked;
    }

    function thumbUrl(project) {
      const quality = project.format === "horizontal" ? "maxresdefault" : "hqdefault";
      return `https://img.youtube.com/vi/${project.youtubeId}/${quality}.jpg`;
    }

    function cardHtml(project) {
      const clientMarkup = project.client ? `<p class="client">${project.client}</p>` : "";
      return `
        <article class="video-card" data-format="${project.format}">
          <button
            class="video-card__thumb"
            type="button"
            data-yt-id="${project.youtubeId}"
            data-yt-title="${project.title}"
            aria-label="Přehrát ukázku: ${project.title}"
          >
            <img src="${thumbUrl(project)}" alt="" loading="lazy" />
            <span class="video-card__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </span>
          </button>
          <div class="video-card__meta">
            <span class="tag">${project.category}</span>
            <h3>${project.title}</h3>
            ${clientMarkup}
            <p class="desc">${project.description}</p>
          </div>
        </article>
      `;
    }

    const dataEl = document.getElementById("ukazky-data");
    const data = dataEl ? JSON.parse(dataEl.textContent || "{}") : { horizontal: [], vertical: [] };

    const leadContainer = document.getElementById("ukazky-lead");
    const verticalContainer = document.getElementById("ukazky-vertical");

    if (leadContainer) {
      leadContainer.innerHTML = pickRandom(data.horizontal || [], 1).map(cardHtml).join("");
    }
    if (verticalContainer) {
      verticalContainer.innerHTML = pickRandom(data.vertical || [], 3).map(cardHtml).join("");
    }
  </script>

  <div class="section-shell section--brown" id="klienti">
    <section class="wrap clients-strip">
      <p class="clients-intro">Pracoval jsem pro</p>
      <ul class="client-list">
        <li>North Moravians</li>
        <li>TMRW Film</li>
        <li>Vesalius</li>
        <li>Dotykačka</li>
        <li>Placement</li>
        <li>Perfectology Brno</li>
        <li>Choice</li>
      </ul>
    </section>
  </div>

  <div class="section-shell section--cream" id="o-mne">
    <section class="wrap page-section text-section about">
      <div
        class="about-portrait bleed-up"
        data-parallax="0.1"
        data-parallax-max="40"
        style="transform: translateY(-3rem);"
      >
        <Image src={portrait} alt="Vojtěch Malohlava" width={640} height={800} />
      </div>
      <div class="about-content">
        <div class="section-heading">
          <h2>O mně</h2>
        </div>
        <p>Nezačal jsem střihem. Začal jsem tím, že jsem chtěl něco ukázat.</p>
        <p>
          Vlogy z vesnice. Potom sestřihy z fotbalu. Roky předtím, než mě
          napadlo, že by z toho mohla být práce.
        </p>
        <p>
          Někde po cestě mi došlo, že mě nebaví natáčení. Baví mě to, co přijde
          potom — moment, kdy se z hodin materiálu skládá něco, co má tempo a
          drží pohromadě. Postprodukce není poslední krok výroby videa. Je to
          krok, ve kterém video buď začne fungovat, nebo ne.
        </p>
        <a class="more" href="/o-mne">Celý příběh</a>
      </div>
    </section>
  </div>

  <div class="section-shell section--brown" id="reference">
    <section class="wrap page-section text-section">
      <div class="section-heading">
        <h2>Co o nás říkají zákazníci</h2>
      </div>
      <div class="testimonial-carousel">
        {testimonials.length > 1 && (
          <button class="carousel-btn carousel-btn--prev" type="button" aria-label="Předchozí hodnocení">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6" />
            </svg>
          </button>
        )}

        <div class="testimonial-stage" id="testimonial-stage">
          {testimonials.map((item) => (
            <blockquote class="testimonial">
              <p>„{item.quote}“</p>
              <footer>
                <div class="testimonial-avatar" set:html={avatarSvg(item.role)} />
                <div class="testimonial-who">
                  <span class="testimonial-name">{item.name}</span>
                  <span class="testimonial-role">{item.role}</span>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>

        {testimonials.length > 1 && (
          <button class="carousel-btn carousel-btn--next" type="button" aria-label="Další hodnocení">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </button>
        )}
      </div>

      {testimonials.length > 1 && (
        <div class="carousel-dots" id="testimonial-dots" role="tablist" aria-label="Vyberte hodnocení">
          {testimonials.map((_, i) => (
            <button
              class="carousel-dot"
              type="button"
              aria-label={`Hodnocení ${i + 1}`}
              aria-current={i === 0 ? "true" : "false"}
            />
          ))}
        </div>
      )}
    </section>
  </div>

  <script is:inline>
    (() => {
      const stage = document.getElementById("testimonial-stage");
      if (!stage) return;

      const slides = Array.from(stage.children);
      const dotsWrap = document.getElementById("testimonial-dots");
      const dots = dotsWrap ? Array.from(dotsWrap.children) : [];
      const prevBtn = document.querySelector(".carousel-btn--prev");
      const nextBtn = document.querySelector(".carousel-btn--next");
      const total = slides.length;

      // Vybere náhodnou recenzi jako první, ale nikdy stejnou jako
      // naposledy (uloženo v localStorage, přežije i reload stránky).
      const STORAGE_KEY = "smallhead-last-testimonial";
      let current = Math.floor(Math.random() * total);
      if (total > 1) {
        let lastIndex = -1;
        try {
          lastIndex = parseInt(localStorage.getItem(STORAGE_KEY) || "-1", 10);
        } catch (e) {}
        const choices = [];
        for (let i = 0; i < total; i++) {
          if (i !== lastIndex) choices.push(i);
        }
        current = choices[Math.floor(Math.random() * choices.length)];
      }
      try {
        localStorage.setItem(STORAGE_KEY, String(current));
      } catch (e) {}

      function render() {
        slides.forEach((slide, i) => {
          slide.classList.remove("is-active", "is-prev", "is-next");
          slide.setAttribute("aria-hidden", "true");
          if (i === current) {
            slide.classList.add("is-active");
            slide.setAttribute("aria-hidden", "false");
          } else if (i === (current - 1 + total) % total) {
            slide.classList.add("is-prev");
          } else if (i === (current + 1) % total) {
            slide.classList.add("is-next");
          }
        });
        dots.forEach((dot, i) => dot.setAttribute("aria-current", i === current ? "true" : "false"));
      }

      function goTo(index) {
        current = ((index % total) + total) % total;
        render();
      }

      if (prevBtn) prevBtn.addEventListener("click", () => goTo(current - 1));
      if (nextBtn) nextBtn.addEventListener("click", () => goTo(current + 1));
      dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

      render();
    })();
  </script>

  <div class="section-shell section--green" id="sluzby">
    <section class="wrap page-section text-section">
      <div class="section-heading">
        <h2>Služby</h2>
      </div>

      <div class="services-grid">
        <article class="service">
          <h3>1 — Edit</h3>
          <p class="lead">
            Kompletní postprodukce. Od surového materiálu po soubor, který jde
            rovnou publikovat.
          </p>
          <p>
            Střih, barevné korekce v DaVinci Resolve, zvuk a mix, motion
            design i titulky — všechno v jedné službě.
          </p>
          <a class="more" href="/sluzby#edit">Podrobnosti a ceník</a>
        </article>

        <article class="service">
          <h3>2 — Konzultace</h3>
          <p class="lead">
            Máte hotové video, které nefunguje. Nebo ho zrovna stříháte a
            nejste si jistí.
          </p>
          <p>
            Projdu vaše video a řeknu vám, co ho brzdí a kde diváci odcházejí
            a proč.
          </p>
          <a class="more" href="/sluzby#konzultace">Podrobnosti a ceník</a>
        </article>
      </div>
    </section>
  </div>

  <div class="section-shell section--brown" id="kontakt">
    <section class="wrap page-section text-section">
      <div class="section-heading">
        <h2>Máte materiál a termín?</h2>
      </div>
      <p>
        Napište mi, o co jde a dokdy to potřebujete. Ozvu se do druhého dne s
        tím, jestli to stihnu a co to bude stát.
      </p>
      <a class="btn" href="mailto:vojta.malohlava1@gmail.com">Napsat e-mail</a>
    </section>
  </div>
</Layout>
