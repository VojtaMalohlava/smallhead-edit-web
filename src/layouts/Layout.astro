---
import "../styles/global.css";
import { SITE_URL } from "../data/site.js";

interface Props {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  "Smallhead Edit — střihová postprodukce videa v Brně. Střih, barevné korekce, motion design i zvuk. Ozvu se do 24 hodin.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = new URL("/og-image.jpg", SITE_URL).toString();

const navItems = [
  { href: "/portfolio", label: "Portfólio" },
  { href: "/#o-mne", label: "O mně" },
  { href: "/#sluzby", label: "Služby" },
  { href: "/#kontakt", label: "Kontakt" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Smallhead Edit</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Smallhead Edit" />
    <meta property="og:title" content={`${title} — Smallhead Edit`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="cs_CZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Smallhead Edit`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Musí běžet synchronně před vykreslením <body>, jinak by se sekce
      // schovaly (viz CSS .js .section-shell) a bez JS by zůstaly navždy
      // neviditelné.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="mark" href="/">Smallhead</a>
        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div>
          Smallhead Edit, Vojtěch Malohlava<br />
          IČO 21636206
        </div>
        <div class="foot-links">
          <a class="foot-email-link" href="#">e-mail</a>
        </div>
      </div>
    </footer>

    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Adresa jako base64, ne čistý text — ať ji nesebere robot, co
      // hledá "@" v HTML. atob() se vyhodnocuje až za běhu.
      document.querySelectorAll(".foot-email-link").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const email = atob("dm9qdGEubWFsb2hsYXZhMUBnbWFpbC5jb20=");
        link.href = `mailto:${email}`;
        link.textContent = email;
      });

      document.addEventListener("click", (event) => {
        const target = event.target;

        const anchorLink = target instanceof Element ? target.closest('a[href^="/#"], a[href^="#"]') : null;
        if (anchorLink instanceof HTMLAnchorElement && anchorLink.pathname === location.pathname) {
          const section = document.getElementById(anchorLink.hash.slice(1));
          if (section) {
            event.preventDefault();
            section.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
            history.pushState(null, "", anchorLink.hash);
          }
          return;
        }

        const button = target instanceof Element ? target.closest(".video-card__thumb") : null;
        if (!(button instanceof HTMLElement)) return;

        const youtubeId = button.dataset.ytId;
        if (!youtubeId) return;

        const iframe = document.createElement("iframe");
        iframe.className = "video-card__thumb";
        iframe.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1&rel=0`;
        iframe.title = button.dataset.ytTitle || "Ukázka práce";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";

        button.replaceWith(iframe);
      });

      const parallaxEls = Array.from(document.querySelectorAll("[data-parallax]")).filter(
        (el) => el instanceof HTMLElement,
      );

      if (parallaxEls.length && !prefersReducedMotion) {
        parallaxEls.forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          // Zachytí libovolný existující transform (rotace, statický posun
          // kvůli přesahu přes hranici sekcí…), paralaxa se na něj jen přičte.
          el.dataset.baseTransform = el.style.transform || "";
        });

        const updateParallax = () => {
          parallaxEls.forEach((el) => {
            if (!(el instanceof HTMLElement)) return;
            const speed = parseFloat(el.dataset.parallax || "0");
            const max = el.dataset.parallaxMax ? parseFloat(el.dataset.parallaxMax) : Infinity;
            const parent = el.parentElement;
            if (!parent) return;
            const parentTop = parent.getBoundingClientRect().top;
            const offset = Math.max(-max, Math.min(max, parentTop * speed));
            el.style.transform = `${el.dataset.baseTransform} translateY(${offset}px)`.trim();
          });
        };

        // Přímá aktualizace bez requestAnimationFrame — pár prvků je levné
        // přepočítat na každý scroll event, žádné zpoždění na jeho projev.
        window.addEventListener("scroll", updateParallax, { passive: true });
        window.addEventListener("resize", updateParallax);
        updateParallax();
      }

      // Odkrývání sekcí při scrollování — jednorázově, nikdy se neopakuje.
      if (!prefersReducedMotion && "IntersectionObserver" in window) {
        const revealEls = document.querySelectorAll(".section-shell");
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.15 },
        );
        revealEls.forEach((el) => revealObserver.observe(el));
      }
    </script>

    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
