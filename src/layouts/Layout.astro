---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: "/prace", label: "Práce" },
  { href: "/sluzby", label: "Služby" },
  { href: "/o-mne", label: "O mně" },
  { href: "/kontakt", label: "Kontakt" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Smallhead Edit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="mark" href="/">Smallhead<span>.</span>Edit</a>
        <nav class="nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div>
          Smallhead Edit, Vojtěch Malohlava<br />
          IČO 21636206
        </div>
        <div class="foot-links">
          <a href="mailto:vojta.malohlava1@gmail.com">vojta.malohlava1@gmail.com</a>
        </div>
      </div>
    </footer>
  </body>
</html>
