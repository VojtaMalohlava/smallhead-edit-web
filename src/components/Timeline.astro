---
// Obaluje sekce stránky svislou časovou osou (jen na desktopu, viz CSS
// v global.css). Uvnitř slotu se očekávají .section-shell prvky, z nichž
// některé obsahují SectionMarker.astro — ty se zvýrazní podle scrollu.
---

<div class="timeline-track">
  <div class="wrap timeline-rail-wrap" aria-hidden="true">
    <div class="timeline-rail">
      <div class="timeline-playhead" id="timeline-playhead"></div>
    </div>
  </div>
  <slot />
</div>

<script is:inline>
  (() => {
    const tracks = document.querySelectorAll(".timeline-track");
    tracks.forEach((track) => {
      const playhead = track.querySelector(".timeline-playhead");
      const markers = Array.from(track.querySelectorAll(".section-marker"));
      if (!playhead || !markers.length) return;

      const sections = markers
        .map((marker) => marker.closest(".section-shell"))
        .filter((el) => el instanceof HTMLElement);

      let ticking = false;

      function update() {
        ticking = false;
        const rect = track.getBoundingClientRect();
        const referenceY = window.innerHeight * 0.35;
        const progress = Math.min(1, Math.max(0, (referenceY - rect.top) / rect.height));
        playhead.style.top = `${progress * 100}%`;

        let activeIndex = -1;
        sections.forEach((section, i) => {
          if (section.getBoundingClientRect().top <= referenceY) activeIndex = i;
        });
        markers.forEach((marker, i) => {
          marker.classList.toggle("is-active", i === activeIndex);
        });
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      // Osa je vidět jen na desktopu (>=1024px), takže i JS jen tam poslouchá.
      if (window.matchMedia("(min-width: 1024px)").matches) {
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      }
    });
  })();
</script>
